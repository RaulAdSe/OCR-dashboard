# CMR OCR System - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Supabase Configuration  
SUPABASE_URL=https://rkytasgvdzfbqruercsm.supabase.co
SUPABASE_ANON_KEY=REDACTED_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REDACTED_SUPABASE_SERVICE_KEY

# Database Connection (for direct queries)
DATABASE_URL=postgresql://postgres:REDACTED_DB_PASSWORD@db.rkytasgvdzfbqruercsm.supabase.co:5432/postgres

# API Keys for enrichment services
GEMINI_API_KEY=your_gemini_api_key_here
SERPAPI_KEY=your_serpapi_key_here
HUNTER_API_KEY=your_hunter_api_key_here

# Google Drive Configuration
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GOOGLE_SHEETS_ID=your_google_sheets_id

# n8n Configuration (if self-hosted)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Processing Configuration
MAX_CONCURRENT_DOCUMENTS=5
OCR_CONFIDENCE_THRESHOLD=0.8
CACHE_EXPIRY_DAYS=30

# Monitoring (optional)
SENTRY_DSN=your_sentry_dsn_here
LOG_LEVEL=info